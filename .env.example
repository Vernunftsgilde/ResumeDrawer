# 复制为 .env.local 后填入真实值（.env.local 已被 .gitignore 排除，不会进仓库）
# 留空或删掉本文件的应用会以「演示模式」运行：使用内置示例数据，不连接云端。

# Supabase Project URL，形如 https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon（public）key。这个 key 会被打进前端产物，是 Supabase 的正常设计，
# 安全性由数据库 RLS 策略保证 —— 但请不要把 service_role key 填在这里。
VITE_SUPABASE_ANON_KEY=

# 站点正式域名，用于生成 sitemap / canonical（部署后填写，如 https://resumedrawer.pages.dev）
VITE_SITE_URL=
